# Copier en .env.local pour le développement, et configurer les mêmes variables
# dans Vercel (Project Settings → Environment Variables) pour Production/Preview.

# --- Public (navigateur) ---
# URL du projet Supabase (ex. https://xxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Clé publishable / anon (publique — la sécurité repose sur les politiques RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL publique de l'application (ex. https://hdy-performance-engine.vercel.app)
# Sert à construire les liens d'invitation. Si absente, l'origine de la requête est utilisée.
NEXT_PUBLIC_APP_URL=

# --- Serveur uniquement (jamais exposé au navigateur) ---
# Clé service_role Supabase — Settings → API. Utilisée par /api/invite/send.
SUPABASE_SERVICE_ROLE_KEY=

# Clé API Resend (https://resend.com) — envoi des e-mails d'invitation.
# Sans cette clé, l'invitation est créée mais le lien doit être transmis manuellement.
RESEND_API_KEY=

# Expéditeur des e-mails, sur un domaine vérifié dans Resend.
# ex. "HDY Performance Engine <invitations@hdyperformancengine.com>"
EMAIL_FROM=
