# Copier en .env.local pour le développement, et configurer les mêmes variables
# dans Vercel (Project Settings → Environment Variables) pour Production/Preview.

# URL du projet Supabase (ex. https://xxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Clé publishable / anon (publique — la sécurité repose sur les politiques RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
